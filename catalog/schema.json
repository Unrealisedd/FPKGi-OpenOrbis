{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Unrealisedd/FPKGi-OpenOrbis/main/catalog/schema.json",
  "title": "FPKGi Native catalog",
  "$comment": "Executable validators additionally enforce string limits as UTF-8 bytes; JSON Schema maxLength counts Unicode code points.",
  "type": "object",
  "required": ["DATA"],
  "additionalProperties": false,
  "properties": {
    "DATA": {
      "maxProperties": 4096,
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "^https?://[^\\s/@#]+(?:/[^\\s#]*)?(?:\\?[^\\s#]*)?$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "nullableText16": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 16
    },
    "package": {
      "type": "object",
      "required": ["title_id", "name", "version", "size"],
      "additionalProperties": false,
      "properties": {
        "title_id": {
          "type": "string",
          "pattern": "^[A-Z]{4}[0-9]{5}$"
        },
        "region": {
          "$ref": "#/$defs/nullableText16"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$"
        },
        "release": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 32
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^0*(?:[1-9][0-9]{0,18}|(?:1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615))$"
        },
        "min_fw": {
          "$ref": "#/$defs/nullableText16"
        },
        "cover_url": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https?://[^\\s/@#]+(?:/[^\\s#]*)?(?:\\?[^\\s#]*)?$"
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    }
  }
}
